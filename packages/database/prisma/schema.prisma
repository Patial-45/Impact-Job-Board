generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  USER
  PLATFORM_ADMIN
  SUPER_ADMIN
}

enum WorkspaceRole {
  OWNER
  ADMIN
  RECRUITER
  VIEWER
}

model User {
  id            String            @id @default(uuid()) @db.Uuid
  email         String            @unique @db.VarChar(320)
  passwordHash  String?           @map("password_hash") @db.VarChar(255)
  globalRole    GlobalRole        @default(USER) @map("global_role")
  emailVerified DateTime?        @map("email_verified")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  deletedAt     DateTime?         @map("deleted_at")
  profile       UserProfile?
  accounts                 Account[]
  sessions                 Session[]
  memberships              WorkspaceMember[]
  candidate                CandidateProfile?
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  sentWorkspaceInvitations WorkspaceInvitation[]    @relation("InvitedByUser")

  @@map("users")
}

model UserProfile {
  userId      String   @id @map("user_id") @db.Uuid
  displayName String?  @map("display_name") @db.VarChar(120)
  avatarKey   String?  @map("avatar_key") @db.VarChar(512)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Account {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String   @db.VarChar(40)
  providerAccountId String   @map("provider_account_id") @db.VarChar(255)
  createdAt         DateTime @default(now()) @map("created_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model Workspace {
  id          String                @id @default(uuid()) @db.Uuid
  slug        String                @unique @db.VarChar(80)
  name        String                @db.VarChar(160)
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  deletedAt   DateTime?             @map("deleted_at")
  company     Company?
  memberships WorkspaceMember[]
  jobs        Job[]
  invitations WorkspaceInvitation[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(VIEWER)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Company {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @unique @map("workspace_id") @db.Uuid
  name        String    @db.VarChar(160)
  slug        String    @unique @db.VarChar(80)
  description String?   @db.Text
  logoKey     String?   @map("logo_key") @db.VarChar(512)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@map("companies")
}

model CandidateProfile {
  id                String                @id @default(uuid()) @db.Uuid
  userId            String                @unique @map("user_id") @db.Uuid
  headline          String?               @db.VarChar(180)
  bio               String?               @db.Text
  location          String?               @db.VarChar(120)
  yearsOfExperience Int?                  @map("years_of_experience")
  phone             String?               @db.VarChar(40)
  websiteUrl        String?               @map("website_url") @db.VarChar(256)
  linkedinUrl       String?               @map("linkedin_url") @db.VarChar(256)
  githubUrl         String?               @map("github_url") @db.VarChar(256)
  searchVisible     Boolean               @default(true) @map("search_visible")
  openToRemote      Boolean               @default(true) @map("open_to_remote")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiences       CandidateExperience[]
  educations        CandidateEducation[]
  skills            CandidateSkill[]
  resumes           CandidateResume[]

  @@map("candidate_profiles")
}

model CandidateExperience {
  id                 String           @id @default(uuid()) @db.Uuid
  candidateProfileId String           @map("candidate_profile_id") @db.Uuid
  companyName        String           @map("company_name") @db.VarChar(160)
  title              String           @db.VarChar(160)
  location           String?          @db.VarChar(120)
  startDate          DateTime         @map("start_date")
  endDate            DateTime?        @map("end_date")
  isCurrent          Boolean          @default(false) @map("is_current")
  description        String?          @db.Text
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@index([candidateProfileId, startDate])
  @@map("candidate_experiences")
}

model CandidateEducation {
  id                 String           @id @default(uuid()) @db.Uuid
  candidateProfileId String           @map("candidate_profile_id") @db.Uuid
  institution        String           @db.VarChar(160)
  degree             String           @db.VarChar(120)
  fieldOfStudy       String?          @map("field_of_study") @db.VarChar(120)
  startDate          DateTime         @map("start_date")
  endDate            DateTime?        @map("end_date")
  description        String?          @db.Text
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@index([candidateProfileId, startDate])
  @@map("candidate_educations")
}

model CandidateSkill {
  id                 String           @id @default(uuid()) @db.Uuid
  candidateProfileId String           @map("candidate_profile_id") @db.Uuid
  name               String           @db.VarChar(80)
  yearsOfExperience  Int?             @map("years_of_experience")
  isPrimary          Boolean          @default(false) @map("is_primary")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@unique([candidateProfileId, name])
  @@map("candidate_skills")
}

enum ResumeParsingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model CandidateResume {
  id                 String              @id @default(uuid()) @db.Uuid
  candidateProfileId String              @map("candidate_profile_id") @db.Uuid
  fileName           String              @map("file_name") @db.VarChar(255)
  fileKey            String              @map("file_key") @db.VarChar(512)
  fileSize           Int                 @map("file_size")
  mimeType           String              @map("mime_type") @db.VarChar(100)
  isPrimary          Boolean             @default(true) @map("is_primary")
  parsedText         String?             @map("parsed_text") @db.Text
  parsedData         Json?               @map("parsed_data")
  parsingStatus      ResumeParsingStatus @default(PENDING) @map("parsing_status")
  errorMessage       String?             @map("error_message") @db.Text
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  candidateProfile   CandidateProfile    @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@index([candidateProfileId, isPrimary])
  @@map("candidate_resumes")
}

model Job {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  slug        String    @db.VarChar(100)
  title       String    @db.VarChar(180)
  description String    @db.Text
  status      JobStatus @default(DRAFT)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, slug])
  @@index([workspaceId, status, createdAt])
  @@map("jobs")
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  usedAt    DateTime? @map("used_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model WorkspaceInvitation {
  id              String        @id @default(uuid()) @db.Uuid
  workspaceId     String        @map("workspace_id") @db.Uuid
  email           String        @db.VarChar(320)
  role            WorkspaceRole @default(VIEWER)
  tokenHash       String        @unique @map("token_hash") @db.Char(64)
  invitedByUserId String        @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime      @map("expires_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  acceptedAt      DateTime?     @map("accepted_at")
  revokedAt       DateTime?     @map("revoked_at")
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy       User          @relation("InvitedByUser", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
  @@map("workspace_invitations")
}

