generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  USER
  PLATFORM_ADMIN
  SUPER_ADMIN
}

enum WorkspaceRole {
  OWNER
  ADMIN
  RECRUITER
  VIEWER
}

model User {
  id            String            @id @default(uuid()) @db.Uuid
  email         String            @unique @db.VarChar(320)
  passwordHash  String?           @map("password_hash") @db.VarChar(255)
  globalRole    GlobalRole        @default(USER) @map("global_role")
  emailVerified DateTime?        @map("email_verified")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  deletedAt     DateTime?         @map("deleted_at")
  profile       UserProfile?
  accounts                 Account[]
  sessions                 Session[]
  memberships              WorkspaceMember[]
  candidate                CandidateProfile?
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  sentWorkspaceInvitations WorkspaceInvitation[]    @relation("InvitedByUser")
  stageChanges             ApplicationStageHistory[]
  applicationNotes         ApplicationNote[]
  interviewParticipants    InterviewParticipant[]
  interviewScorecards      InterviewScorecard[]
  createdOffers            JobOffer[]               @relation("CreatedByUser")
  approvedOffers           JobOffer[]               @relation("ApprovedByUser")
  supportElevations        SupportElevation[]       @relation("AdminSupportElevations")
  auditLogs                AuditLog[]               @relation("UserAuditLogs")

  @@map("users")
}

model UserProfile {
  userId      String   @id @map("user_id") @db.Uuid
  displayName String?  @map("display_name") @db.VarChar(120)
  avatarKey   String?  @map("avatar_key") @db.VarChar(512)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Account {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String   @db.VarChar(40)
  providerAccountId String   @map("provider_account_id") @db.VarChar(255)
  createdAt         DateTime @default(now()) @map("created_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model Workspace {
  id          String                @id @default(uuid()) @db.Uuid
  slug        String                @unique @db.VarChar(80)
  name        String                @db.VarChar(160)
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  deletedAt   DateTime?             @map("deleted_at")
  company     Company?
  memberships WorkspaceMember[]
  jobs        Job[]
  invitations WorkspaceInvitation[]
  applicationNotes ApplicationNote[]
  savedCandidates  SavedCandidate[]
  interviews       Interview[]
  assessments      Assessment[]
  offers           JobOffer[]
  onboardingTasks  OnboardingTask[]
  subscription     WorkspaceSubscription?
  supportElevations SupportElevation[]
  auditLogs        AuditLog[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(VIEWER)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Company {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @unique @map("workspace_id") @db.Uuid
  name        String    @db.VarChar(160)
  slug        String    @unique @db.VarChar(80)
  description String?   @db.Text
  website     String?   @db.VarChar(256)
  industry    String?   @db.VarChar(100)
  size        String?   @db.VarChar(50)
  location    String?   @db.VarChar(160)
  logoKey     String?   @map("logo_key") @db.VarChar(512)
  bannerKey   String?   @map("banner_key") @db.VarChar(512)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@map("companies")
}

model CandidateProfile {
  id                String                @id @default(uuid()) @db.Uuid
  userId            String                @unique @map("user_id") @db.Uuid
  headline          String?               @db.VarChar(180)
  bio               String?               @db.Text
  location          String?               @db.VarChar(120)
  yearsOfExperience Int?                  @map("years_of_experience")
  phone             String?               @db.VarChar(40)
  websiteUrl        String?               @map("website_url") @db.VarChar(256)
  linkedinUrl       String?               @map("linkedin_url") @db.VarChar(256)
  githubUrl         String?               @map("github_url") @db.VarChar(256)
  searchVisible     Boolean               @default(true) @map("search_visible")
  openToRemote      Boolean               @default(true) @map("open_to_remote")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiences       CandidateExperience[]
  educations        CandidateEducation[]
  skills            CandidateSkill[]
  resumes           CandidateResume[]
  applications      Application[]
  savedJobs         SavedJob[]
  savedByWorkspaces SavedCandidate[]
  embedding         CandidateProfileEmbedding?
  matchResults      MatchResult[]

  @@map("candidate_profiles")
}

model CandidateExperience {
  id                 String           @id @default(uuid()) @db.Uuid
  candidateProfileId String           @map("candidate_profile_id") @db.Uuid
  companyName        String           @map("company_name") @db.VarChar(160)
  title              String           @db.VarChar(160)
  location           String?          @db.VarChar(120)
  startDate          DateTime         @map("start_date")
  endDate            DateTime?        @map("end_date")
  isCurrent          Boolean          @default(false) @map("is_current")
  description        String?          @db.Text
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@index([candidateProfileId, startDate])
  @@map("candidate_experiences")
}

model CandidateEducation {
  id                 String           @id @default(uuid()) @db.Uuid
  candidateProfileId String           @map("candidate_profile_id") @db.Uuid
  institution        String           @db.VarChar(160)
  degree             String           @db.VarChar(120)
  fieldOfStudy       String?          @map("field_of_study") @db.VarChar(120)
  startDate          DateTime         @map("start_date")
  endDate            DateTime?        @map("end_date")
  description        String?          @db.Text
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@index([candidateProfileId, startDate])
  @@map("candidate_educations")
}

model CandidateSkill {
  id                 String           @id @default(uuid()) @db.Uuid
  candidateProfileId String           @map("candidate_profile_id") @db.Uuid
  name               String           @db.VarChar(80)
  yearsOfExperience  Int?             @map("years_of_experience")
  isPrimary          Boolean          @default(false) @map("is_primary")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@unique([candidateProfileId, name])
  @@map("candidate_skills")
}

enum ResumeParsingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model CandidateResume {
  id                 String              @id @default(uuid()) @db.Uuid
  candidateProfileId String              @map("candidate_profile_id") @db.Uuid
  fileName           String              @map("file_name") @db.VarChar(255)
  fileKey            String              @map("file_key") @db.VarChar(512)
  fileSize           Int                 @map("file_size")
  mimeType           String              @map("mime_type") @db.VarChar(100)
  isPrimary          Boolean             @default(true) @map("is_primary")
  parsedText         String?             @map("parsed_text") @db.Text
  parsedData         Json?               @map("parsed_data")
  parsingStatus      ResumeParsingStatus @default(PENDING) @map("parsing_status")
  errorMessage       String?             @map("error_message") @db.Text
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  candidateProfile   CandidateProfile    @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  applications       Application[]

  @@index([candidateProfileId, isPrimary])
  @@map("candidate_resumes")
}

enum JobRemoteType {
  ONSITE
  HYBRID
  REMOTE
}

enum JobEmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum JobExperienceLevel {
  ENTRY
  MID
  SENIOR
  LEAD
  EXECUTIVE
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model Job {
  id              String             @id @default(uuid()) @db.Uuid
  workspaceId     String             @map("workspace_id") @db.Uuid
  slug            String             @db.VarChar(100)
  title           String             @db.VarChar(180)
  description     String             @db.Text
  department      String?            @db.VarChar(100)
  location        String?            @db.VarChar(160)
  remoteType      JobRemoteType      @default(REMOTE) @map("remote_type")
  employmentType  JobEmploymentType  @default(FULL_TIME) @map("employment_type")
  experienceLevel JobExperienceLevel @default(MID) @map("experience_level")
  minSalary       Int?               @map("min_salary")
  maxSalary       Int?               @map("max_salary")
  currency        String?            @default("USD") @db.VarChar(10)
  status          JobStatus          @default(DRAFT)
  publishedAt     DateTime?          @map("published_at")
  closedAt        DateTime?          @map("closed_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  deletedAt       DateTime?          @map("deleted_at")
  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  skills          JobSkill[]
  applications    Application[]
  savedByCandidates SavedJob[]
  embedding       JobEmbedding?
  matchResults    MatchResult[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, status, createdAt])
  @@index([status, publishedAt])
  @@map("jobs")
}

model JobSkill {
  id         String   @id @default(uuid()) @db.Uuid
  jobId      String   @map("job_id") @db.Uuid
  name       String   @db.VarChar(80)
  isRequired Boolean  @default(true) @map("is_required")
  createdAt  DateTime @default(now()) @map("created_at")
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, name])
  @@map("job_skills")
}

enum ApplicationStatus {
  SUBMITTED
  IN_REVIEW
  INTERVIEWING
  OFFERED
  HIRED
  REJECTED
  WITHDRAWN
}

model Application {
  id                 String                   @id @default(uuid()) @db.Uuid
  jobId              String                   @map("job_id") @db.Uuid
  candidateProfileId String                   @map("candidate_profile_id") @db.Uuid
  resumeId           String?                  @map("resume_id") @db.Uuid
  status             ApplicationStatus        @default(SUBMITTED)
  currentStage       String                   @default("APPLIED") @map("current_stage") @db.VarChar(60)
  coverLetter        String?                  @map("cover_letter") @db.Text
  rejectedReason     String?                  @map("rejected_reason") @db.VarChar(255)
  withdrawnReason    String?                  @map("withdrawn_reason") @db.VarChar(255)
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  job                Job                      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateProfile   CandidateProfile         @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  resume             CandidateResume?         @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  stageHistory       ApplicationStageHistory[]
  notes              ApplicationNote[]
  interviews         Interview[]
  assessmentInvites  AssessmentInvite[]
  offers             JobOffer[]

  @@unique([jobId, candidateProfileId])
  @@index([jobId, status, createdAt])
  @@index([candidateProfileId, createdAt])
  @@map("applications")
}

model ApplicationStageHistory {
  id              String      @id @default(uuid()) @db.Uuid
  applicationId   String      @map("application_id") @db.Uuid
  stage           String      @db.VarChar(60)
  changedByUserId String?     @map("changed_by_user_id") @db.Uuid
  notes           String?     @db.Text
  createdAt       DateTime    @default(now()) @map("created_at")
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedByUser   User?       @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@map("application_stage_histories")
}

model ApplicationNote {
  id            String      @id @default(uuid()) @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  workspaceId   String      @map("workspace_id") @db.Uuid
  authorUserId  String      @map("author_user_id") @db.Uuid
  content       String      @db.Text
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author        User        @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("application_notes")
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  usedAt    DateTime? @map("used_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model WorkspaceInvitation {
  id              String        @id @default(uuid()) @db.Uuid
  workspaceId     String        @map("workspace_id") @db.Uuid
  email           String        @db.VarChar(320)
  role            WorkspaceRole @default(VIEWER)
  tokenHash       String        @unique @map("token_hash") @db.Char(64)
  invitedByUserId String        @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime      @map("expires_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  acceptedAt      DateTime?     @map("accepted_at")
  revokedAt       DateTime?     @map("revoked_at")
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy       User          @relation("InvitedByUser", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
  @@map("workspace_invitations")
}

model SavedJob {
  id                 String           @id @default(uuid()) @db.Uuid
  candidateProfileId String           @map("candidate_profile_id") @db.Uuid
  jobId              String           @map("job_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at")
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  job                Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([candidateProfileId, jobId])
  @@index([candidateProfileId, createdAt])
  @@map("saved_jobs")
}

model SavedCandidate {
  id                 String           @id @default(uuid()) @db.Uuid
  workspaceId        String           @map("workspace_id") @db.Uuid
  candidateProfileId String           @map("candidate_profile_id") @db.Uuid
  notes              String?          @db.Text
  createdAt          DateTime         @default(now()) @map("created_at")
  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, candidateProfileId])
  @@index([workspaceId, createdAt])
  @@map("saved_candidates")
}

model CandidateProfileEmbedding {
  id                 String           @id @default(uuid()) @db.Uuid
  candidateProfileId String           @unique @map("candidate_profile_id") @db.Uuid
  embeddingVersion   String           @map("embedding_version") @db.VarChar(64)
  embedding          Float[]          @map("embedding")
  sourceHash         String           @map("source_hash") @db.VarChar(64)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@map("candidate_profile_embeddings")
}

model JobEmbedding {
  id               String   @id @default(uuid()) @db.Uuid
  jobId            String   @unique @map("job_id") @db.Uuid
  embeddingVersion String   @map("embedding_version") @db.VarChar(64)
  embedding        Float[]  @map("embedding")
  sourceHash       String   @map("source_hash") @db.VarChar(64)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  job              Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_embeddings")
}

model MatchResult {
  id                 String           @id @default(uuid()) @db.Uuid
  jobId              String           @map("job_id") @db.Uuid
  candidateProfileId String           @map("candidate_profile_id") @db.Uuid
  overallScore       Float            @map("overall_score")
  skillsScore        Float            @map("skills_score")
  semanticScore      Float            @map("semantic_score")
  experienceScore    Float            @map("experience_score")
  locationScore      Float            @map("location_score")
  matchedSkills      String[]         @map("matched_skills")
  missingSkills      String[]         @map("missing_skills")
  explanation        String?          @map("explanation") @db.Text
  modelVersion       String           @default("hybrid-v1") @map("model_version") @db.VarChar(64)
  calculatedAt       DateTime         @default(now()) @map("calculated_at")
  job                Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@unique([jobId, candidateProfileId])
  @@index([jobId, overallScore])
  @@index([candidateProfileId, overallScore])
  @@map("match_results")
}

// -------------------------------------------------------------
// Phase 8: Interviews, Assessments & Scorecards
// -------------------------------------------------------------

enum InterviewType {
  SCREENING
  TECHNICAL
  BEHAVIORAL
  EXECUTIVE
  FINAL
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
  NO_SHOW
}

enum ScorecardRecommendation {
  STRONG_HIRE
  HIRE
  NO_HIRE
  STRONG_NO_HIRE
}

enum AssessmentInviteStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

model Interview {
  id                 String                 @id @default(uuid()) @db.Uuid
  workspaceId        String                 @map("workspace_id") @db.Uuid
  applicationId      String                 @map("application_id") @db.Uuid
  title              String                 @db.VarChar(160)
  type               InterviewType          @default(TECHNICAL)
  status             InterviewStatus        @default(SCHEDULED)
  scheduledAt        DateTime               @map("scheduled_at")
  durationMinutes    Int                    @default(45) @map("duration_minutes")
  location           String?                @db.VarChar(512)
  timezone           String                 @default("UTC") @db.VarChar(64)
  notes              String?                @db.Text
  cancellationReason String?                @map("cancellation_reason") @db.VarChar(255)
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  workspace          Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  application        Application            @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  participants       InterviewParticipant[]
  scorecards         InterviewScorecard[]

  @@index([workspaceId, scheduledAt])
  @@index([applicationId])
  @@map("interviews")
}

model InterviewParticipant {
  id          String    @id @default(uuid()) @db.Uuid
  interviewId String    @map("interview_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  role        String    @default("INTERVIEWER") @db.VarChar(40)
  createdAt   DateTime  @default(now()) @map("created_at")
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([interviewId, userId])
  @@map("interview_participants")
}

model InterviewScorecard {
  id                  String                  @id @default(uuid()) @db.Uuid
  interviewId         String                  @map("interview_id") @db.Uuid
  evaluatorId         String                  @map("evaluator_id") @db.Uuid
  recommendation      ScorecardRecommendation
  overallRating       Int                     @map("overall_rating")
  technicalRating     Int?                    @map("technical_rating")
  communicationRating Int?                    @map("communication_rating")
  leadershipRating    Int?                    @map("leadership_rating")
  cultureRating       Int?                    @map("culture_rating")
  strengths           String?                 @db.Text
  weaknesses          String?                 @db.Text
  notes               String?                 @db.Text
  submittedAt         DateTime                @default(now()) @map("submitted_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  interview           Interview               @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  evaluator           User                    @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)

  @@unique([interviewId, evaluatorId])
  @@index([interviewId])
  @@map("interview_scorecards")
}

model Assessment {
  id               String             @id @default(uuid()) @db.Uuid
  workspaceId      String             @map("workspace_id") @db.Uuid
  title            String             @db.VarChar(160)
  description      String?            @db.Text
  timeLimitMinutes Int?               @map("time_limit_minutes")
  passingScore     Int?               @map("passing_score")
  questions        Json?              @map("questions")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  workspace        Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invites          AssessmentInvite[]

  @@index([workspaceId])
  @@map("assessments")
}

model AssessmentInvite {
  id            String                 @id @default(uuid()) @db.Uuid
  assessmentId  String                 @map("assessment_id") @db.Uuid
  applicationId String                 @map("application_id") @db.Uuid
  token         String                 @unique @db.VarChar(128)
  status        AssessmentInviteStatus @default(PENDING)
  score         Int?
  feedback      String?                @db.Text
  expiresAt     DateTime               @map("expires_at")
  completedAt   DateTime?              @map("completed_at")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  assessment    Assessment             @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  application   Application            @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, applicationId])
  @@index([token])
  @@map("assessment_invites")
}

enum OfferStatus {
  DRAFT
  PENDING_APPROVAL
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  RESCINDED
}

enum OnboardingTaskStatus {
  PENDING
  COMPLETED
  WAIVED
}

model JobOffer {
  id              String           @id @default(uuid()) @db.Uuid
  workspaceId     String           @map("workspace_id") @db.Uuid
  applicationId   String           @map("application_id") @db.Uuid
  jobTitle        String           @map("job_title") @db.VarChar(160)
  baseSalary      Int              @map("base_salary")
  currency        String           @default("USD") @db.VarChar(3)
  bonus           String?          @db.VarChar(160)
  equity          String?          @db.VarChar(160)
  signOnBonus     Int?             @map("sign_on_bonus")
  startDate       DateTime         @map("start_date")
  expiresAt       DateTime         @map("expires_at")
  workLocation    String           @map("work_location") @db.VarChar(160)
  offerLetter     String?          @map("offer_letter") @db.Text
  notes           String?          @db.Text
  status          OfferStatus      @default(DRAFT)
  createdById     String           @map("created_by_id") @db.Uuid
  approvedById    String?          @map("approved_by_id") @db.Uuid
  approvedAt      DateTime?        @map("approved_at")
  sentAt          DateTime?        @map("sent_at")
  respondedAt     DateTime?        @map("responded_at")
  rescindReason   String?          @map("rescind_reason") @db.Text
  declineReason   String?          @map("decline_reason") @db.Text
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  application     Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdBy       User             @relation("CreatedByUser", fields: [createdById], references: [id], onDelete: Cascade)
  approvedBy      User?            @relation("ApprovedByUser", fields: [approvedById], references: [id], onDelete: SetNull)
  signature       OfferSignature?
  onboardingTasks OnboardingTask[]

  @@index([workspaceId, status])
  @@index([applicationId])
  @@map("job_offers")
}

model OfferSignature {
  id            String   @id @default(uuid()) @db.Uuid
  offerId       String   @unique @map("offer_id") @db.Uuid
  signerName    String   @map("signer_name") @db.VarChar(120)
  signerEmail   String   @map("signer_email") @db.VarChar(320)
  signatureText String   @map("signature_text") @db.VarChar(160)
  ipAddress     String?  @map("ip_address") @db.VarChar(64)
  userAgent     String?  @map("user_agent") @db.Text
  signedAt      DateTime @default(now()) @map("signed_at")

  offer         JobOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@map("offer_signatures")
}

model OnboardingTask {
  id                 String               @id @default(uuid()) @db.Uuid
  workspaceId        String               @map("workspace_id") @db.Uuid
  offerId            String               @map("offer_id") @db.Uuid
  title              String               @db.VarChar(160)
  description        String?              @db.Text
  category           String               @default("GENERAL") @db.VarChar(60)
  required           Boolean              @default(true)
  status             OnboardingTaskStatus @default(PENDING)
  dueDate            DateTime?            @map("due_date")
  completedAt        DateTime?            @map("completed_at")
  completedByUserId  String?              @map("completed_by_user_id") @db.Uuid
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  workspace          Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  offer              JobOffer             @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([offerId])
  @@map("onboarding_tasks")
}

enum SubscriptionTier {
  STARTER
  GROWTH
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

model WorkspaceSubscription {
  id                   String             @id @default(uuid()) @db.Uuid
  workspaceId          String             @unique @map("workspace_id") @db.Uuid
  tier                 SubscriptionTier   @default(STARTER)
  status               SubscriptionStatus @default(ACTIVE)
  billingCycle         BillingCycle       @default(MONTHLY) @map("billing_cycle")
  currentPeriodStart   DateTime           @default(now()) @map("current_period_start")
  currentPeriodEnd     DateTime           @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  activeJobLimit       Int                @default(3) @map("active_job_limit")
  candidateSearchLimit Int                @default(50) @map("candidate_search_limit")
  stripeCustomerId     String?            @map("stripe_customer_id") @db.VarChar(255)
  stripeSubscriptionId String?            @map("stripe_subscription_id") @db.VarChar(255)
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  workspace            Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@map("workspace_subscriptions")
}

model SupportElevation {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  adminUserId  String    @map("admin_user_id") @db.Uuid
  reason       String    @db.Text
  scope        String    @default("READ_ONLY") @db.VarChar(100)
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  adminUser    User      @relation("AdminSupportElevations", fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId, expiresAt])
  @@index([adminUserId, expiresAt])
  @@map("support_elevations")
}

model AuditLog {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String?    @map("workspace_id") @db.Uuid
  actorUserId String?    @map("actor_user_id") @db.Uuid
  actorEmail  String     @map("actor_email") @db.VarChar(320)
  action      String     @db.VarChar(100)
  targetType  String     @map("target_type") @db.VarChar(60)
  targetId    String?    @map("target_id") @db.VarChar(100)
  details     Json?
  ipAddress   String?    @map("ip_address") @db.VarChar(64)
  userAgent   String?    @map("user_agent") @db.Text
  createdAt   DateTime   @default(now()) @map("created_at")

  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actorUser   User?      @relation("UserAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}




