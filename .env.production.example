# ==============================================================================
# Executive Match — Production Environment Configuration Specification
# DO NOT COMMIT THE ACTUAL .env.production FILE WITH REAL SECRETS
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Runtime & Security
# ------------------------------------------------------------------------------
NODE_ENV="production"

# Must be a cryptographically random string (min 32 characters, recommended 64)
# Generate via: openssl rand -base64 48
AUTH_SECRET="REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS"

# Listening port for NestJS API process (default 4000 or assigned by cloud platform via $PORT)
API_PORT="4000"

# ------------------------------------------------------------------------------
# 2. Network Routing & Multi-Tenant Domains
# ------------------------------------------------------------------------------
# Fully qualified public URL where Next.js web application is accessible
WEB_URL="https://executivematch.com"
NEXT_PUBLIC_APP_URL="https://executivematch.com"

# Fully qualified public URL where NestJS REST API is accessible
# Browser requests route here with credentials (HttpOnly SameSite cookies)
NEXT_PUBLIC_API_URL="https://api.executivematch.com/api/v1"

# ------------------------------------------------------------------------------
# 3. Managed Relational Database & Semantic Vector Storage
# ------------------------------------------------------------------------------
# PostgreSQL 16 connection string with SSL mode enabled (e.g., Neon, Supabase, Railway Postgres)
# Requires pgvector extension enabled for 1536-dimensional semantic candidate retrieval
DATABASE_URL="postgresql://db_user:db_password@db_host:5432/executive_match?sslmode=require&schema=public"

# ------------------------------------------------------------------------------
# 4. Asynchronous Queues & Worker Runtime (BullMQ)
# ------------------------------------------------------------------------------
# Managed Redis 7 connection string with TLS (e.g., Upstash, Railway Redis, Redis Cloud)
REDIS_URL="rediss://default:redis_password@redis_host:6379"

# ------------------------------------------------------------------------------
# 5. Cloudflare R2 / AWS S3 Object Storage (Candidate CVs & Artifacts)
# ------------------------------------------------------------------------------
# S3-compatible private storage endpoint with short-lived presigned URL capability
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="executive-match-production-resumes"
S3_ACCESS_KEY="REPLACE_WITH_S3_R2_ACCESS_KEY_ID"
S3_SECRET_KEY="REPLACE_WITH_S3_R2_SECRET_ACCESS_KEY"

# ------------------------------------------------------------------------------
# 6. AI Inference & Embedding Providers
# ------------------------------------------------------------------------------
# OpenAI API key used for text-embedding-3-small (1536d) and resume parsing
OPENAI_API_KEY="sk-proj-REPLACE_WITH_PRODUCTION_OPENAI_API_KEY"

# Optional secondary/fallback LLM provider
ANTHROPIC_API_KEY="sk-ant-REPLACE_WITH_PRODUCTION_ANTHROPIC_API_KEY"

# ------------------------------------------------------------------------------
# 7. Transactional Email & Notifications (Resend)
# ------------------------------------------------------------------------------
# API key for dispatching interview confirmations, offer alerts, and verification tokens
RESEND_API_KEY="re_REPLACE_WITH_PRODUCTION_RESEND_API_KEY"
EMAIL_FROM="Executive Match <notifications@executivematch.com>"

# ------------------------------------------------------------------------------
# 8. Enterprise OAuth & SSO (Google Cloud Identity)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET"

# ------------------------------------------------------------------------------
# 9. Observability, Crash Telemetry & Product Analytics
# ------------------------------------------------------------------------------
# Sentry DSN for API and Worker runtime crash reporting
SENTRY_DSN="https://REPLACE_KEY@o0.ingest.sentry.io/REPLACE_PROJECT"

# PostHog public project token for client-side user telemetry (optional)
NEXT_PUBLIC_POSTHOG_KEY="phc_REPLACE_WITH_POSTHOG_PROJECT_KEY"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
